@page "/mensagem"
@rendermode InteractiveServer

<button class="btn btn-primary mb-3" @onclick="AlternarVisibilidade">
    @(exibirMensagem ? "Ocultar Mensagem" : "Exibir Mensagem")
</button>

@if (exibirMensagem)
{
    <p class="alert alert-success">Bem-vindo ao desenvolvimento web com .NET 10!</p>
}

@code {
    private bool exibirMensagem = false;

    private void AlternarVisibilidade()
    {
        exibirMensagem = !exibirMensagem;
    }
}
